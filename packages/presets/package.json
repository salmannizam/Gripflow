{
  "name": "@gripflow/presets",
  "version": "0.1.0",
  "description": "Ready-made React sortable list, grid and table components for Gripflow, with an optional CSS-variable stylesheet. Bring your own markup and styling.",
  "keywords": [
    "gripflow",
    "drag-and-drop",
    "drag and drop",
    "dnd",
    "typescript",
    "headless",
    "accessible",
    "keyboard",
    "react",
    "sortable-list",
    "sortable-table",
    "sortable-grid",
    "reorder",
    "list",
    "table",
    "grid",
    "nextjs"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@gripflow/core": "0.1.0"
  },
  "peerDependencies": {
    "@gripflow/react": "0.1.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/REPLACE-ME/gripflow.git",
    "directory": "packages/presets"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://github.com/REPLACE-ME/gripflow#readme",
  "bugs": {
    "url": "https://github.com/REPLACE-ME/gripflow/issues"
  }
}
