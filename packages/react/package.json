{
  "name": "@gripflow/react",
  "version": "0.1.0",
  "description": "React drag and drop for Gripflow: DragDropProvider, useDraggable, useDroppable, useSortable and DragOverlay. Headless, accessible, works with Next.js, Tailwind, Bootstrap or plain CSS.",
  "keywords": [
    "gripflow",
    "drag-and-drop",
    "drag and drop",
    "dnd",
    "typescript",
    "headless",
    "accessible",
    "keyboard",
    "react",
    "react-dnd",
    "react-drag-and-drop",
    "react-sortable",
    "nextjs",
    "hooks",
    "tailwind",
    "bootstrap"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@gripflow/core": "0.1.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/REPLACE-ME/gripflow.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://github.com/REPLACE-ME/gripflow#readme",
  "bugs": {
    "url": "https://github.com/REPLACE-ME/gripflow/issues"
  }
}
