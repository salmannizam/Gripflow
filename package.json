{
  "name": "gripflow-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Gripflow - a headless, styling-independent drag-and-drop toolkit (monorepo).",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/core",
    "packages/react",
    "packages/tree",
    "packages/kanban",
    "packages/presets",
    "packages/nestjs-adapter",
    "apps/playground"
  ],
  "scripts": {
    "build": "npm run build -w packages/core -w packages/react -w packages/tree -w packages/kanban -w packages/presets -w packages/nestjs-adapter",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "pack:all": "node scripts/pack-all.mjs",
    "verify:packages": "node scripts/verify-packages.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run verify:packages"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "@axe-core/playwright": "^4.13.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
